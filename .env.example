POSTGRES_DB=agent_workspace
POSTGRES_USER=agent_workspace
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+asyncpg://agent_workspace:change-me-in-production@postgres:5432/agent_workspace

# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-64-char-string-before-deploying-to-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173

# LLM provider keys — leave blank if unused
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
